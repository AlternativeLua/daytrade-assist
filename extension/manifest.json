{
  "manifest_version": 3,
  "name": "Daytrade Assist — Pocket Option bridge",
  "version": "0.1.0",
  "description": "Read-only: forwards the Pocket Option price stream your browser already receives to Daytrade Assist on this computer. Never places trades.",
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Daytrade Assist bridge" },
  "content_scripts": [
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*",
        "https://po.trade/*",
        "https://*.po.trade/*",
        "https://po2.trade/*",
        "https://*.po2.trade/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*",
        "https://po.trade/*",
        "https://*.po.trade/*",
        "https://po2.trade/*",
        "https://*.po2.trade/*"
      ],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
